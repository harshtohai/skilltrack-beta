// OutcomeTrack Prisma Schema
// Longitudinal skilling outcomes platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum OutcomeStatus {
  EMPLOYED
  SELF_EMPLOYED
  APPRENTICE
  LOOKING
  NOT_WORKING
  UNKNOWN
}

enum VerificationStatus {
  UNKNOWN
  SELF_REPORTED
  PROVIDER_CONFIRMED
  EMPLOYER_CONFIRMED
  DOCUMENT_VERIFIED
  SYSTEM_VERIFIED
  CONFLICT
}

enum SalaryBand {
  LT_10K
  B_10_20K
  B_20_35K
  B_35_50K
  GT_50K
}

enum NonPlacementReason {
  NO_JOBS
  SKILLS_MISMATCH
  FAMILY
  HEALTH
  OTHER
}

enum FollowupStatus {
  SCHEDULED
  SENT
  RESPONDED
  FAILED
  EXPIRED
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum BotSessionState {
  AWAITING_CONSENT
  AWAITING_STATUS
  AWAITING_EMPLOYER_NAME
  AWAITING_ROLE
  AWAITING_SALARY_BAND
  AWAITING_NON_PLACEMENT_REASON
  AWAITING_RETENTION_STATUS
  AWAITING_RETENTION_SALARY_BAND
  DONE
}

enum ActorType {
  ADMIN
  TRAINEE
  EMPLOYER
  SYSTEM
}

// Job Board (F25)
enum EmployerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  HIRED
  REJECTED
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

// Core Tables
model TrainingCenter {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  district    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohorts     Cohort[]

  @@map("training_centers")
}

model Course {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  skills      String[]
  durationWeeks Int
  level       String   // BEGINNER, INTERMEDIATE, ADVANCED
  provider    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model Programme {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cohorts   Cohort[]

  @@map("programmes")
}

model Cohort {
  id               String    @id @default(uuid())
  programmeId      String
  trainingCenterId String?
  name             String
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  programme        Programme @relation(fields: [programmeId], references: [id])
  trainingCenter   TrainingCenter? @relation(fields: [trainingCenterId], references: [id])
  enrolments       Enrolment[]
  followupEvents   FollowupEvent[]

  @@map("cohorts")
}

model Trainee {
  id              String    @id @default(uuid())
  publicId        String    @unique @default(uuid())
  fullName        String
  phoneE164       String    @unique
  phoneEncrypted  String    @unique
  phoneHash       String    @unique
  email           String?   @unique
  district        String
  language        String    @default("EN")
  consentGiven    Boolean   @default(false)
  consentGivenAt  DateTime?
  consentMethod   String?
  conversationState Json?
  consentRevokedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrolments           Enrolment[]
  followupEvents       FollowupEvent[]
  botSessions          BotSession[]
  employmentClaims     EmploymentClaim[]
  outcomeEvents        OutcomeEvent[]
  certificates         Certificate[]
  employmentHistory    EmploymentHistory[]
  loginTokens          TraineeLoginToken[]
  jobApplications      JobApplication[]
  jobSeekSignals       JobSeekSignal[]

  @@index([phoneE164])
  @@index([phoneEncrypted])
  @@index([phoneHash])
  @@index([email])
  @@map("trainees")
}

model Enrolment {
  id                 String    @id @default(uuid())
  traineeId          String
  cohortId           String
  certificationDate  DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trainee            Trainee   @relation(fields: [traineeId], references: [id])
  cohort             Cohort    @relation(fields: [cohortId], references: [id])

  @@unique([traineeId, cohortId])
  @@map("enrolments")
}

model FollowupEvent {
  id               String        @id @default(uuid())
  traineeId        String
  cohortId         String
  checkpointDays   Int
  status           FollowupStatus @default(SCHEDULED)
  channel          Channel       @default(WHATSAPP)
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  trainee          Trainee       @relation(fields: [traineeId], references: [id])
  cohort           Cohort        @relation(fields: [cohortId], references: [id])
  botSessions      BotSession[]
  employmentClaims EmploymentClaim[]

  @@index([traineeId, checkpointDays, status])
  @@map("followup_events")
}

model BotSession {
  id                  String            @id @default(uuid())
  traineeId           String
  followupEventId     String
  state               BotSessionState   @default(AWAITING_STATUS)
  currentQuestion     String?
  collectedData       Json              @default("{}")
  expiresAt           DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  trainee             Trainee           @relation(fields: [traineeId], references: [id])
  followupEvent       FollowupEvent     @relation(fields: [followupEventId], references: [id])

  @@index([traineeId])
  @@map("bot_sessions")
}

model EmploymentClaim {
  id                     String              @id @default(uuid())
  traineeId              String
  followupEventId        String
  employerName           String?
  role                   String?
  salaryBand             SalaryBand?
  nonPlacementReason     NonPlacementReason?
  verificationStatus     VerificationStatus  @default(SELF_REPORTED)
  evidenceLevel          Int                 @default(1)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  trainee                Trainee             @relation(fields: [traineeId], references: [id])
  followupEvent          FollowupEvent       @relation(fields: [followupEventId], references: [id])
  verificationRequests   VerificationRequest[]
  outcomeEvents          OutcomeEvent[]

  @@index([traineeId])
  @@map("employment_claims")
}

model OutcomeEvent {
  id                  String              @id @default(uuid())
  traineeId           String
  employmentClaimId   String?
  checkpointDays      Int
  outcomeStatus       OutcomeStatus
  verificationStatus  VerificationStatus
  source              String              // TRAINEE, EMPLOYER, SYSTEM
  evidenceLevel       Int
  createdAt           DateTime            @default(now())

  trainee             Trainee             @relation(fields: [traineeId], references: [id])
  employmentClaim     EmploymentClaim?    @relation(fields: [employmentClaimId], references: [id])

  @@index([traineeId, checkpointDays, createdAt])
  @@map("outcome_events")
}

model VerificationRequest {
  id                  String    @id @default(uuid())
  employmentClaimId   String
  tokenHash           String    @unique
  expiresAt           DateTime
  usedAt              DateTime?
  action              String?   // CONFIRMED, REJECTED
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employmentClaim     EmploymentClaim @relation(fields: [employmentClaimId], references: [id])

  @@map("verification_requests")
}

model AuditEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  actorType   ActorType
  actorId     String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}

model Certificate {
  id          String   @id @default(uuid())
  traineeId   String
  name        String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainee     Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@index([traineeId])
  @@map("certificates")
}

model EmploymentHistory {
  id          String    @id @default(uuid())
  traineeId   String
  employer    String
  role        String
  salaryBand  SalaryBand?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trainee     Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@index([traineeId])
  @@map("employment_history")
}

model TraineeLoginToken {
  id        String   @id @default(uuid())
  traineeId String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@index([traineeId])
  @@map("trainee_login_tokens")
}

// Views (optional - backend falls back to raw SQL if not available)
// model TraineeLatestOutcome {
//   // v_trainee_latest_outcome
// }
//
// model CohortOverview {
//   // v_cohort_overview
// }
//
model SurveyResponse {
  id                   String   @id @default(uuid())
  phoneE164            String
  traineeId            String?
  employmentStatus     String?
  employerName         String?
  role                 String?
  salaryRange          String?
  jobSatisfaction     String?
  trainingRelevance   String?
  skillGaps            String[]
  additionalTraining   String?
  careerGoals          String?
  challenges           String[]
  recommendations      String?
  language             String?
  supportNeeded        String?
  completedAt          DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([phoneE164])
  @@index([traineeId])
  @@map("survey_responses")
}

// Job Board (F25)
model Employer {
  id                 String                     @id @default(uuid())
  companyName        String
  contactEmail       String                     @unique
  passwordHash       String
  sector             String
  district           String
  registrationNo     String?                    // GSTIN/CIN
  hiringNeeds        String?
  employeeCount      Int?
  verificationStatus EmployerVerificationStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  jobPostings JobPosting[]

  @@index([verificationStatus])
  @@map("employers")
}

model JobPosting {
  id                  String           @id @default(uuid())
  employerId          String
  title               String
  description         String
  employmentType      EmploymentType
  workMode            WorkMode
  salaryBand          SalaryBand?
  district            String
  skillsRequired      String[]
  openings            Int              @default(1)
  applicationDeadline DateTime?
  status              JobPostingStatus @default(OPEN)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  employer     Employer         @relation(fields: [employerId], references: [id])
  applications JobApplication[]

  @@index([status, district])
  @@index([employerId])
  @@map("job_postings")
}

model JobApplication {
  id           String               @id @default(uuid())
  jobPostingId String
  traineeId    String
  status       JobApplicationStatus @default(APPLIED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])
  trainee    Trainee    @relation(fields: [traineeId], references: [id])

  @@unique([jobPostingId, traineeId])
  @@index([traineeId])
  @@map("job_applications")
}

model JobSeekSignal {
  id        String             @id @default(uuid())
  traineeId String
  reason    NonPlacementReason
  district  String
  createdAt DateTime           @default(now())

  trainee Trainee @relation(fields: [traineeId], references: [id])

  @@index([district, createdAt])
  @@map("job_seek_signals")
}

