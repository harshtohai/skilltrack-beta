# Since the ".env" file is gitignored, copy this file to ".env" and fill in
# your values when you clone the repo. Keep this file up-to-date when you add
# new variables to `.env`.
#
# This file is committed to version control — never put secrets or personal
# data in it. The validation schema lives in `/src/env.js`.

# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection for app queries (Supabase pooler uses port 6543 + pgBouncer)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skilltrack"
# Direct connection for migrations (Supabase: port 5432)
DIRECT_URL="postgresql://postgres:password@localhost:5432/skilltrack"

# ── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# JWT session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to "true" when running outside Vercel
# AUTH_TRUST_HOST="true"

# ── App URLs ────────────────────────────────────────────────────────────────
# Absolute base URL used in magic links
APP_BASE_URL="http://localhost:3000"
# Optional (T3 scaffold leftovers, safe to leave unset)
# BACKEND_BASE_URL=""
# NEXT_PUBLIC_APP_URL=""

# ── Phone privacy ───────────────────────────────────────────────────────────
# Pepper for the deterministic phone lookup hash + key for AES encryption
PHONE_HASH_PEPPER=""
PHONE_ENCRYPTION_KEY=""

# ── Internal service key ────────────────────────────────────────────────────
# Required by /api/v1/bot/* endpoints (X-API-Key header)
INTERNAL_API_KEY=""
# Same key, inlined into the client bundle for the /simulator page
NEXT_PUBLIC_INTERNAL_API_KEY=""

# ── WhatsApp via Kapso (optional — simulator works without these) ───────────
KAPSO_API_KEY=""
KAPSO_PHONE_NUMBER_ID=""
KAPSO_VERIFY_TOKEN=""
KAPSO_WEBHOOK_SECRET=""
# Optional: cohort follow-up trigger pushes to an external bot service
# when BOT_MODE=real (default "mock")
# BOT_BASE_URL=""
# BOT_MODE="mock"

# ── Email (Brevo) ───────────────────────────────────────────────────────────
# Free tier: 300 emails/day from one verified sender
BREVO_API_KEY=""
EMAIL_FROM=""

# ── Demo credentials (optional — code defaults exist for all three) ─────────
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# INSTITUTE_EMAIL=""
# INSTITUTE_PASSWORD=""
# EMPLOYER_EMAIL=""
# EMPLOYER_PASSWORD=""

# ── Dev scripts ─────────────────────────────────────────────────────────────
# Read by scripts/test-bot-trigger.ts
# TEST_TRAINEE_PHONE=""
# TEST_TRAINEE_NAME=""
# TEST_TRAINEE_EMAIL=""
